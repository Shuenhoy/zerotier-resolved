[Unit]
Description=ZeroTier resolved daemon for interface %i
BindsTo=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device
# The daemon polls zerotier-one, so it should not start before it is up.
Wants=zerotier-one.service
After=zerotier-one.service

[Service]
Type=simple
ExecStart=/usr/bin/python /usr/bin/zerotier-resolved.py -v -d -I %i
# Belt and braces: the script reverts DNS settings itself on SIGTERM, but this
# also cleans up if the daemon was killed or crashed.
ExecStopPost=-/usr/bin/resolvectl revert %i
Restart=on-failure
RestartSec=5s
# Only signal the main process on stop, so its cleanup (resolvectl revert)
# is not interfered with. Anything left over is SIGKILLed after the timeout.
KillMode=mixed
TimeoutStopSec=15s

ProtectSystem=strict
PrivateDevices=true
PrivateTmp=true
ProtectKernelLogs=true
ProtectProc=invisible
# PrivateUsers=true cannot be used because authtoken.secret is owned by a non-root user
ProtectHome=true
UMask=0077
RestrictNamespaces=true
LockPersonality=true
NoNewPrivileges=true
ProtectKernelModules=true
SystemCallArchitectures=native
ProtectHostname=true
# netlink and unix required by resolvectl
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictRealtime=true
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
ProtectClock=true
ProcSubset=pid
# required to read authtoken.secret file
CapabilityBoundingSet=cap_dac_override
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
MemoryDenyWriteExecute=yes
DevicePolicy=closed
IPAddressAllow=localhost
IPAddressDeny=any

[Install]
WantedBy=sys-subsystem-net-devices-%i.device
